# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
build/
dist/
*.egg-info/

# Local configuration and secrets. Current project credentials live outside the
# repository under the host's user config directory.
.env
.env.*
!.env.example
secrets/

# Retained raw data and rebuildable analysis data
data/raw/*
!data/raw/README.md
data/interim/*
!data/interim/README.md
data/processed/*
!data/processed/README.md
data/unified/*
!data/unified/README.md

# The ranked pair-contribution panel is large and derived; regenerate it with
# scripts/analyze/run_vehicle_rotation_composition_e0.py.
/output/exhibits/vehicle_transition_pair_contributions.parquet

# Logs and scratch
*.log
.DS_Store

# Literature payloads that may not be redistributable
literature/*.pdf
literature/*.epub
literature/papers/
literature/sources.local.json
# Historical safety guard; current browser authentication lives outside the repo.
literature/auth/

# LaTeX auxiliary files. Canonical PDFs remain tracked even though a fresh
# clone can rebuild them.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/main.pdf
deck/*.aux
deck/*.bbl
deck/*.blg
deck/*.fdb_latexmk
deck/*.fls
deck/*.log
deck/*.nav
deck/*.out
deck/*.snm
deck/*.toc
deck/*.synctex.gz
