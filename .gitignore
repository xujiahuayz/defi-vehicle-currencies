# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
build/
dist/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example
# secrets/ holds minted_graph_keys.json: the burner wallets behind the Graph API
# key pool, private keys included. Never committed; back it up out of band.
secrets/

# Data and intermediate generated artifacts
data/raw/
data/interim/
data/processed/
data/external/
data/unified
data/metrics/
data/exhibits/
data/empirical/
output/model/
output/empirical/
output/robustness/
output/provisional/
# flock files keep a stable inode after release; they are runtime state, not artefacts.
/output/exhibits/.*.lock

# Logs and scratch
logs/
*.log
.DS_Store

# Literature payloads that may not be redistributable
literature/*.pdf
literature/*.epub
literature/papers/
literature/sources.local.json
literature/auth/

# LaTeX auxiliary files
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz

# Provenance stamps ARE tracked: they are the record of how each derived
# artefact was produced, and provenance that does not travel with the repository
# is not provenance. They are small JSON sidecars.
!data/manifests/

# LaTeX build artefacts. The PDF is regenerable from the sources with one latexmk call.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/main.pdf
deck/*.aux
deck/*.fdb_latexmk
deck/*.fls
deck/*.log
deck/*.nav
deck/*.out
deck/*.snm
deck/*.toc
deck/main.pdf
