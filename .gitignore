# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
build/
dist/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example

# Data and intermediate generated artifacts
data/raw/
data/interim/
data/processed/
data/external/
data/unified/
data/metrics/
data/exhibits/
data/empirical/
output/model/
output/empirical/
output/robustness/

# Logs and scratch
logs/
*.log
.DS_Store

# Literature payloads that may not be redistributable
literature/*.pdf
literature/*.epub
literature/papers/
literature/sources.local.json
literature/auth/

# LaTeX auxiliary files
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz

# Provenance stamps ARE tracked: they are the record of how each derived
# artefact was produced, and provenance that does not travel with the repository
# is not provenance. They are small JSON sidecars.
!data/manifests/
